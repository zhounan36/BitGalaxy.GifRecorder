// 资源文件：嵌入图标、manifest 与版本信息
#include <windows.h>

#define IDI_APP 101

// 应用图标（exe/安装包/任务栏共用，多尺寸 16-256）
IDI_APP ICON "assets/app.ico"

1 24 "app.manifest"

#define VER_FILEVERSION 1,3,0,0
#define VER_FILEVERSION_STR "1.3.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_FILEVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "BitGalaxy"
            VALUE "FileDescription",  "BitGalaxy GIF 录屏工具"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "BitGalaxy.GifRecorder"
            VALUE "OriginalFilename", "BitGalaxy.GifRecorder.exe"
            VALUE "ProductName",      "BitGalaxy.GifRecorder"
            VALUE "ProductVersion",   VER_FILEVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
